# ============================================================================
# 3D Dispatch — backend environment
# Copy to .env and fill in. The demo runs with the defaults below (SQLite +
# dev auth), so you can boot it with an empty .env.
# ============================================================================

# --- Database ---------------------------------------------------------------
# Local demo (zero setup):
DATABASE_URL=sqlite+aiosqlite:///./dispatch.db
# Production (Supabase) — use the connection-pooler URL:
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DB_ECHO=false

# --- Auth -------------------------------------------------------------------
# dev      : no JWT; tenant comes from the X-Dealer-Id header (LOCAL ONLY).
# supabase : verify the Supabase JWT and resolve the dealer from user_profiles.
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
API_PREFIX=/api

# --- Demo clock -------------------------------------------------------------
# Written automatically by seed.py so the demo board is alive at any hour and
# the Match Scores are reproducible. Leave empty in production.
DEMO_NOW=
